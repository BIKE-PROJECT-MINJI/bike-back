# Local development template. Copy to `.env` and replace values locally.
# Do not commit real secrets.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/bike
SPRING_DATASOURCE_USERNAME=bike
SPRING_DATASOURCE_PASSWORD=bike

SPRING_DATA_REDIS_URL=redis://localhost:6380
BIKE_RATE_LIMIT_STORE=redis

AUTH_JWT_SECRET=replace-with-at-least-32-byte-random-secret
AUTH_JWT_ISSUER=bike-back
AUTH_JWT_TOKEN_VALIDITY_SEC=900

PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
MANAGEMENT_PORT=18081
MANAGEMENT_SERVER_ADDRESS=0.0.0.0

# Optional local smoke value. Do not commit a real token.
NGROK_AUTHTOKEN=

ADDRESS_SEARCH_PROVIDER=fake
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_LOCAL_REST_API_KEY=

BICYCLE_ROUTING_PROVIDER=graphhopper
BICYCLE_ROUTING_FAKE_ENABLED=false
KAKAO_MOBILITY_BASE_URL=https://apis-navi.kakaomobility.com
KAKAO_MOBILITY_REST_API_KEY=
GRAPHHOPPER_BASE_URL=http://127.0.0.1:8989
GRAPHHOPPER_HOSTED_BASE_URL=
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_RETRY_MAX_ATTEMPTS=2

# Optional AI route worker. Leave unset/blank to use backend deterministic plan only.
# Host bootRun uses 127.0.0.1; backend inside compose network uses http://ai-route-worker:8091.
# AI_ROUTE_WORKER_BASE_URL=http://127.0.0.1:8091

# Optional self-host GraphHopper local runtime profile values.
GRAPHHOPPER_VERSION=11.0
GRAPHHOPPER_OSM_FILE=south-korea-latest.osm.pbf
GRAPHHOPPER_JAVA_XMX=2g

# Optional AI worker secret. Do not commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
