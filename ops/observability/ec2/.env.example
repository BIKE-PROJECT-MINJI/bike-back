GRAFANA_DOMAIN=observability.gajabike.shop
GRAFANA_ROOT_URL=https://observability.gajabike.shop
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
APP_PRIVATE_HOST=10.0.10.12
# App EC2 must set MANAGEMENT_PROMETHEUS_PUBLIC_SCRAPE_ENABLED=true.
# The management port must stay private-security-group only and must not be routed through the public ALB.
# Metrics still record every request/operation; these options only reduce app log noise and disk IO during load tests.
BIKE_OBSERVABILITY_HTTP_LOG_MODE=SLOW_OR_ERROR
BIKE_OBSERVABILITY_HTTP_SLOW_THRESHOLD_MS=500
BIKE_OBSERVABILITY_HTTP_SAMPLE_RATE=0.0
BIKE_OBSERVABILITY_OPERATION_LOG_MODE=SLOW_OR_ERROR
BIKE_OBSERVABILITY_OPERATION_SLOW_THRESHOLD_MS=200
BIKE_OBSERVABILITY_OPERATION_SAMPLE_RATE=0.0
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT_MS=5000
BIKE_DATABASE_BACKPRESSURE_ENABLED=true
BIKE_DATABASE_BACKPRESSURE_ACTIVE_THRESHOLD_RATIO=1.0
BIKE_DATABASE_BACKPRESSURE_PENDING_THRESHOLD=1
POSTGRES_EXPORTER_DSN=postgresql://bike:change-me@10.0.20.10:5432/bike?sslmode=disable
REDIS_EXPORTER_ADDR=redis://10.0.10.12:6379
REDIS_EXPORTER_SKIP_TLS_VERIFICATION=false
