# AWS/compose k6 target
BASE_URL=http://127.0.0.1:8080
TEST_ID=bike-ai-route-aws-20260607
SUMMARY_PATH=ops/loadtest/results/bike-ai-route-aws-20260607-summary.json

# 25 + 35 + 30 + 10 + 0 = 100 concurrent virtual users
# 포트폴리오 대표 혼합 시나리오:
# AI 코스 생성 25%, 코스/지도 조회 35%, 코스 따라가기 30%, 자유주행 저장 10%
# 혼합 부하에서는 finalization READY를 실패 기준으로 강제하지 않고 metric으로만 본다.
AI_ROUTE_VUS=25
COURSE_MAP_READ_VUS=35
COURSE_FOLLOW_VUS=30
FREE_RIDE_VUS=10
RIDE_FINALIZATION_VUS=0
RUN_DURATION=2m
SLEEP_SECONDS=1
PROMOTE_AI_COURSE_RATE=0.2

# finalization 전용 SLA 테스트를 실행할 때만 아래처럼 켠다.
# 예: RIDE_FINALIZATION_VUS=10, RIDE_FINALIZATION_REQUIRE_READY=true
COURSE_READY_MAX_ATTEMPTS=80
COURSE_READY_POLL_SECONDS=0.1
RIDE_FINALIZATION_REQUIRE_READY=false
RIDE_FINALIZATION_READY_FAILURE_THRESHOLD=0.01
